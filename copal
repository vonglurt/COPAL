#  COPAL ALPINE LINUX -- the front door.
#
# copal-prep.sh is 11,720 lines and its first question is "what is this card
# for?", asked with no context at all. That is the wrong first thing to see.
# Someone arriving here needs to know what they are about to start, what it
# will cost them in time and hardware, and where it ends -- BEFORE they pick a
# number and a script starts erasing a disk.
#
# So this is the front door: a flow chart, a target menu, and a per-target
# briefing covering equipment, CPU, minimum requirements and expected use.
# It writes nothing and touches no disk. Every path out of it ends in an
# explicit "Begin" that names the script it is about to hand over to.
#
# Usage:  ./copal                 the menu
#         ./copal --flow          print the flow chart and exit
#         ./copal --check         check what THIS Mac can build, and exit
#         ./copal --targets       list the targets, one per line, and exit
set -eu

HERE="$(cd "$(dirname "$0")" && pwd)"
PREP="$HERE/copal-prep.sh"

B='\033[1m'; D='\033[2m'; C='\033[36m'; G='\033[32m'; Y='\033[33m'; R='\033[31m'; Z='\033[0m'
[ -t 1 ] || { B=''; D=''; C=''; G=''; Y=''; R=''; Z=''; }

say()  { printf '%b\n' "$*"; }
rule() { say "${D}────────────────────────────────────────────────────────────────────${Z}"; }
pause() {
    printf '%b' "\n${G}Press Enter to continue${Z}${D} (Ctrl-C to quit)${Z} "
    read -r _ </dev/tty || exit 130
}

banner() {
    say ""
    say "${Y} ██████  ██████  ██████   █████  ██${Z}"
    say "${Y}██      ██    ██ ██   ██ ██   ██ ██${Z}"
    say "${Y}██      ██    ██ ██████  ███████ ██${Z}"
    say "${Y}██      ██    ██ ██      ██   ██ ██${Z}"
    say "${Y} ██████  ██████  ██████  ██   ██ ███████${Z}"
    say ""
    say "${B}copal-alpine-linux${Z} -- one Alpine installer, many targets."
    say "${D}Tree resin caught halfway to amber: hardened, but not yet stone.${Z}"
}

# --------------------------------------------------------------- flow chart ---
# The whole journey on one screen. Deliberately medium-agnostic: the left
# column is always this Mac, the right column is always the machine being
# built, and the only thing that changes between targets is what sits in the
# middle. Someone who reads this knows what they are signing up for.
flow() {
    say ""
    say "${B}THE PROCESS, BEGINNING TO END${Z}"
    rule
    say ""
    say "  ${C}ON THIS MAC${Z}                          ${C}ON THE MACHINE YOU ARE BUILDING${Z}"
    say "  ${D}(nothing is erased until step 3)${Z}      ${D}(Alpine, running from RAM at first)${Z}"
    say ""
    say "  ${B}1${Z} Choose a target ${D}............${Z} you are here"
    say "     ${D}board, PC or VM -- this decides the CPU and the bootloader${Z}"
    say "     ${D}|${Z}"
    say "  ${B}2${Z} Download Alpine"
    say "     ${D}~70-390 MB, SHA256 verified. A bad download is refused,${Z}"
    say "     ${D}never written.${Z}"
    say "     ${D}|${Z}"
    say "  ${B}3${Z} Prepare the medium ${G}<- first destructive step${Z}"
    say "     ${D}MBR: FAT32 boot partition + a slot for the Linux root.${Z}"
    say "     ${D}A card is erased here. A disk image or VM costs nothing.${Z}"
    say "     ${D}|${Z}"
    say "  ${B}4${Z} Copy the payload"
    say "     ${D}Copied as FILES, never written as a block image.${Z}"
    say "     ${D}|${Z}"
    say "  ${B}5${Z} Write the installer"
    say "     ${D}copal-init.sh + your answers land on the boot partition.${Z}"
    say "     ${D}|${Z}"
    say "     ${D}+------------- boot the target -------------+${Z}"
    say "                                          ${D}|${Z}"
    say "                                       ${B}6${Z} Stage 1  base config, password"
    say "                                          ${D}|${Z}"
    say "                                       ${B}7${Z} Stage 2  ext4 filesystem"
    say "                                          ${D}|${Z}"
    say "                                       ${B}8${Z} Stage 3  move / onto disk ${Y}(reboots)${Z}"
    say "                                          ${D}   until here the root is a tmpfs${Z}"
    say "                                          ${D}   that evaporates at power-off${Z}"
    say "                                          ${D}|${Z}"
    say "                                       ${B}9${Z} Stage 4  ${G}X.Org + i3 -- the desktop${Z}"
    say "                                          ${D}|${Z}"
    say "                                      ${B}10${Z} Stages 5-15 ${D}all optional,${Z}"
    say "                                          ${D}   all re-runnable: zram, SSH,${Z}"
    say "                                          ${D}   toolchain, 316 apps, emulators${Z}"
    say ""
    rule
    say "  ${D}Steps 1-5 are this script. Steps 6-10 run on the target itself,${Z}"
    say "  ${D}from a menu -- one at a time, or 'copal --auto' for all of them.${Z}"
    say "  ${D}macOS cannot create ext4, which is why the split falls here.${Z}"
    say ""
}

# ------------------------------------------------------------- the targets ---
# key | menu label | arch | one-line use case
targets() {
    cat <<'TABLE'
zero |Pi Zero / Zero W / Pi 1 / CM1|armhf  |The original target. 512 MB, single core, no browser but BadWolf
pi2b |Pi 2 B v1.1                  |armv7  |The only 32-bit quad-core Pi. Rare; check /proc/cpuinfo first
zero2|Pi Zero 2 W / Pi 3 / CM3     |aarch64|64-bit in the same footprint. Firefox and Chromium both build
pi4  |Pi 4 / 400 / CM4             |aarch64|Enough RAM to be a real desktop. The comfortable Pi
pi5  |Pi 5                         |aarch64|Fastest Pi. NVMe over PCIe if you have the hat
pc   |PC / laptop / Intel Mac      |x86_64 |Any UEFI machine since roughly 2012. Revives old hardware
pc32 |PC, 32-bit UEFI              |x86    |Early-2010s Atom netbooks and some Bay Trail tablets
vm   |UTM on Apple Silicon         |aarch64|A VM on THIS Mac at native speed. No card, no reboot cycle
vmx86|UTM x86_64 on Apple Silicon  |x86_64 |Emulated. Verifies the PC path without a spare PC
TABLE
}

target_key()   { targets | sed -n "${1}p" | cut -d'|' -f1 | tr -d ' '; }
target_label() { targets | sed -n "${1}p" | cut -d'|' -f2 | sed 's/ *$//'; }
target_arch()  { targets | sed -n "${1}p" | cut -d'|' -f3 | tr -d ' '; }
target_use()   { targets | sed -n "${1}p" | cut -d'|' -f4; }

# Which targets are actually buildable today. vmx86 is the one Phase 1 adds:
# MODEL=vm implies aarch64, and the VM GRUB config hardcodes console=ttyAMA0,
# which is the ARM PL011 and does not exist on x86. Saying so here is better
# than letting someone build a VM that boots to a console nobody can see.
target_ready() { return 0; }

menu() {
    say ""
    say "${B}CHOOSE A TARGET${Z}"
    rule
    say "  ${D}The architecture is not a preference. Getting it wrong is not a${Z}"
    say "  ${D}degraded system -- it is a machine that stops dead at boot.${Z}"
    say ""
    say "  ${C}Raspberry Pi${Z} ${D}-- SD card, booted by the GPU firmware${Z}"
    i=1
    while [ "$i" -le 9 ]; do
        [ "$i" = 6 ] && { say ""; say "  ${C}PC${Z} ${D}-- UEFI only. Legacy BIOS is not supported; see 'w' below${Z}"; }
        [ "$i" = 8 ] && { say ""; say "  ${C}Virtual machine${Z} ${D}-- UTM on this Mac, no hardware at all${Z}"; }
        k=$(target_key "$i")
        if target_ready "$k"; then
            printf '    %b%d%b) %-30s %-8s %b%s%b\n' "$B" "$i" "$Z" \
                "$(target_label "$i")" "$(target_arch "$i")" "$D" "$(target_use "$i")" "$Z"
        else
            printf '    %b%d) %-30s %-8s %s -- NOT YET BUILT%b\n' "$D" "$i" \
                "$(target_label "$i")" "$(target_arch "$i")" "$(target_use "$i")" "$Z"
        fi
        i=$((i + 1))
    done
    say ""
    say "  ${B}f${Z}) Show the flow chart again"
    say "  ${B}r${Z}) What can this Mac build?  ${D}(requirements check -- writes nothing)${Z}"
    say "  ${B}w${Z}) Why UEFI only, and other things worth knowing first"
    say "  ${B}q${Z}) Quit"
    say ""
}

# ------------------------------------------------------- per-target detail ---
# Equipment, CPU, minimum requirements, expected use. Shown BEFORE the handover,
# because "8 GB card minimum" is useless information after the erase.
detail() {
    k="$1"
    say ""
    say "${B}$(printf '%s' "$2" | tr '[:lower:]' '[:upper:]')${Z}   ${D}${3}${Z}"
    rule
    case "$k" in
    zero|pi2b|zero2|pi4|pi5)
        case "$k" in
        zero)  cpu="ARM1176JZF-S, 1 core @ 1 GHz (ARMv6)";  ram="512 MB, shared with the GPU" ;;
        pi2b)  cpu="Cortex-A7, 4 cores @ 900 MHz (ARMv7)";  ram="1 GB" ;;
        zero2) cpu="Cortex-A53, 4 cores @ 1 GHz (ARMv8)";   ram="512 MB (Zero 2 W) / 1 GB (Pi 3)" ;;
        pi4)   cpu="Cortex-A72, 4 cores @ 1.5 GHz";         ram="1-8 GB, depending on model" ;;
        pi5)   cpu="Cortex-A76, 4 cores @ 2.4 GHz";         ram="4-16 GB" ;;
        esac
        say ""
        say "  ${C}Equipment you need${Z}"
        say "    - The board itself, and a power supply that can actually feed it"
        say "    - An SD card, ${B}8 GB minimum${Z}, 16 GB or more recommended"
        say "    - A card reader on this Mac"
        say "    - HDMI display and a USB keyboard, ${B}or${Z} a USB-serial adapter"
        say "      ${D}on the GPIO header (enable_uart=1 is set for you)${Z}"
        say "    - Network: Ethernet, or Wi-Fi credentials to type in at stage 1"
        say ""
        say "  ${C}CPU / RAM${Z}"
        say "    ${cpu}"
        say "    ${ram}"
        say ""
        say "  ${C}Minimum requirements${Z}"
        say "    - 8 GB card ${D}(4 GB of it becomes the boot partition)${Z}"
        say "    - ~1 GB free on this Mac for the download"
        say "    - Your macOS password ${D}(fdisk needs sudo for the partition table)${Z}"
        say ""
        say "  ${C}Expected use case${Z}"
        [ "$k" = zero ] && {
        say "    A permanent, always-on little machine: SSH box, sensor logger,"
        say "    print server, or a genuinely usable tiling desktop on hardware"
        say "    most people have written off. No Firefox or Chromium exist for"
        say "    ARMv6 anywhere -- BadWolf over WebKitGTK is the browser, and it"
        say "    is a current engine with current TLS."; }
        [ "$k" = pi2b ] && {
        say "    The same as the Zero, with four cores. Check /proc/cpuinfo says"
        say "    Cortex-A7 first: the v1.2 board is a Cortex-A53 and needs the"
        say "    aarch64 target instead."; }
        [ "$k" = zero2 ] && {
        say "    The sweet spot. 64-bit means Firefox ESR and Chromium are both"
        say "    packaged, the toolchain is complete, and the emulators run. Still"
        say "    512 MB on a Zero 2 W, so stage 5 (zram) is the difference between"
        say "    slow and unusable."; }
        [ "$k" = pi4 ] && {
        say "    A desktop you would actually sit at. Enough RAM for a browser and"
        say "    an IDE at the same time. Boot from USB or NVMe if you would rather"
        say "    not trust a card."; }
        [ "$k" = pi5 ] && {
        say "    The fastest thing this installer targets. Compiles the workshop"
        say "    (Mini vMac, PianoBooster) in minutes rather than hours."; }
        say ""
        say "  ${Y}Time${Z}  ~10 min on this Mac, then 20 min to 2 h on the board"
        say "        ${D}depending on how many of the fifteen stages you run${Z}"
        ;;
    pc|pc32)
        say ""
        say "  ${C}Equipment you need${Z}"
        say "    - A PC, laptop or Intel Mac that boots ${B}UEFI${Z}"
        say "    - An SD card or USB stick, ${B}8 GB minimum${Z}"
        say "    - A way to tell the firmware to boot from it"
        say "      ${D}(usually F12, F2, Esc or Option at power-on)${Z}"
        say ""
        say "  ${C}CPU${Z}"
        [ "$k" = pc ] && say "    Any x86_64 with UEFI firmware -- roughly 2012 onward."
        [ "$k" = pc ] && say "    Every Intel Mac qualifies."
        [ "$k" = pc32 ] && say "    32-bit UEFI: early-2010s Atom netbooks, some Bay Trail"
        [ "$k" = pc32 ] && say "    tablets. Unusual, and not the same as a 32-bit CPU."
        say ""
        say "  ${C}Minimum requirements${Z}"
        say "    - 1 GB RAM to boot, 2 GB to run the desktop comfortably"
        say "    - 8 GB card or stick"
        say "    - ~400 MB free on this Mac ${D}(the netboot payload carries every"
        say "      module, and the GRUB ISO is another 66 MB)${Z}"
        say ""
        say "  ${R}Legacy BIOS is not supported${Z}, and that is a limit of the"
        say "  writing machine rather than a preference. A BIOS boot needs"
        say "  syslinux or grub-install to write a boot sector, and both are"
        say "  Linux tools that do not exist on macOS. There is no honest way"
        say "  to fake it, so this refuses instead of writing a dead card."
        say ""
        say "  ${C}Expected use case${Z}"
        say "    Bringing an old laptop back as something useful, with a system"
        say "    that boots in seconds and does not grow. Same fifteen stages and"
        say "    same 316-application catalogue as the Pi."
        say ""
        say "  ${Y}Time${Z}  ~10 min on this Mac, then 20 min to 2 h on the machine"
        ;;
    vm)
        say ""
        say "  ${C}Equipment you need${Z}"
        say "    - This Mac. That is the entire list."
        say "    - UTM ${D}(https://mac.getutm.app)${Z}, or QEMU from Homebrew"
        say ""
        say "  ${C}CPU${Z}"
        say "    Apple Silicon, virtualised through HVF -- so the guest runs"
        say "    aarch64 code ${B}natively${Z}, at full speed. Not emulation."
        say ""
        say "  ${C}Minimum requirements${Z}"
        say "    - A 64 GB image ${D}(the default). Sparse, so a fresh one costs${Z}"
        say "      ${D}~550 MB on disk; a full install grows it to 15-25 GB.${Z}"
        say "      ${D}4 GB goes to the boot partition, ~60 GiB is the root.${Z}"
        say "    - 6 GB RAM allotted to the VM"
        say "    - No card, no reader, no password, nothing erased"
        say ""
        say "  ${C}Expected use case${Z}"
        say "    ${B}This is the one to start with.${Z} It runs the identical code"
        say "    path a Pi Zero 2 W boots -- same aarch64 payload, same GRUB, same"
        say "    copal-init.sh -- so it is both a way to try the whole thing"
        say "    without hardware, and the regression test for every change to"
        say "    the installer. A boot that would cost a card write and a walk to"
        say "    the Pi costs about a minute here, with a serial log to read."
        say ""
        say "  ${Y}Time${Z}  ~5 min to build, then boots in seconds"
        ;;
    vmx86)
        say ""
        say "  ${C}Equipment you need${Z}"
        say "    - This Mac, and UTM. That is the entire list."
        say ""
        say "  ${C}CPU${Z}"
        say "    x86_64, ${B}emulated${Z} by QEMU's TCG translator. Apple Silicon"
        say "    cannot virtualise x86, so every instruction is translated --"
        say "    perhaps 5-20x slower than the aarch64 VM. Usable, not pleasant."
        say ""
        say "  ${C}Minimum requirements${Z}"
        say "    - A 64 GB image ${D}(default, sparse -- ~550 MB to start)${Z}"
        say "    - 6 GB RAM allotted to the VM"
        say "    - Patience. Stage 7 and stage 9 compile things."
        say ""
        say "  ${C}Expected use case${Z}"
        say "    Verifying the ${B}pc${Z} target without owning a PC. It boots the"
        say "    same x86_64 payload, the same GRUB from the same ISO and the"
        say "    same copal-init.sh that an ordinary UEFI laptop would -- so a"
        say "    change that breaks the PC path breaks here first, on a machine"
        say "    that costs nothing to rebuild."
        say ""
        say "    The one thing it does not share with a real PC is the firmware."
        say "    UTM supplies OVMF; your laptop supplies whatever its vendor"
        say "    shipped, and that is where the remaining surprises live."
        say ""
        say "  ${Y}Time${Z}  ~5 min to build, then slow to install"
    esac
    say ""
    rule
}

# ------------------------------------------------------- requirements check ---
# What this particular Mac can do, checked rather than assumed.
check_host() {
    say ""
    say "${B}WHAT THIS MAC CAN BUILD${Z}"
    rule
    say ""
    hostarch="$(uname -m)"
    printf '  %-24s %s\n' "macOS" "$(sw_vers -productVersion 2>/dev/null || echo unknown)"
    printf '  %-24s %s\n' "Architecture" "$hostarch"
    printf '  %-24s %s\n' "Model" "$(sysctl -n hw.model 2>/dev/null || echo unknown)"
    printf '  %-24s %s cores\n' "CPU" "$(sysctl -n hw.ncpu 2>/dev/null || echo '?')"
    printf '  %-24s %s GB\n' "RAM" "$(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1073741824 ))"
    printf '  %-24s %s\n' "Free disk" "$(df -h /System/Volumes/Data 2>/dev/null | awk 'NR==2{print $4}')"
    say ""
    for t in curl shasum bsdtar diskutil hdiutil; do
        if command -v "$t" >/dev/null 2>&1; then
            printf '  %b[ok]%b   %-18s %s\n' "$G" "$Z" "$t" "required, present"
        else
            printf '  %b[--]%b   %-18s %s\n' "$R" "$Z" "$t" "REQUIRED, MISSING"
        fi
    done
    if [ -d /Applications/UTM.app ]; then
        printf '  %b[ok]%b   %-18s %s\n' "$G" "$Z" "UTM" \
            "$(defaults read /Applications/UTM.app/Contents/Info.plist CFBundleShortVersionString 2>/dev/null || echo present)"
    else
        printf '  %b[  ]%b   %-18s %s\n' "$Y" "$Z" "UTM" "absent -- needed only for the VM targets"
    fi
    if command -v qemu-system-aarch64 >/dev/null 2>&1; then
        printf '  %b[ok]%b   %-18s %s\n' "$G" "$Z" "qemu" "present -- copal-vm.sh can boot images directly"
    else
        printf '  %b[  ]%b   %-18s %s\n' "$Y" "$Z" "qemu" "absent -- optional (brew install qemu)"
    fi
    say ""
    if [ "$hostarch" = arm64 ]; then
        say "  ${G}Apple Silicon.${Z} The aarch64 VM target runs natively through"
        say "  HVF. The x86_64 VM target will be emulated, and slow."
    else
        say "  ${Y}Intel Mac.${Z} The x86_64 VM target would run natively here;"
        say "  the aarch64 one would be emulated. Card targets are unaffected."
    fi
    say ""
    say "  ${D}All card and PC targets can be built from any Mac -- the payload is${Z}"
    say "  ${D}copied, never executed, so the host architecture does not matter.${Z}"
    say ""
    rule
}

worth_knowing() {
    say ""
    say "${B}WORTH KNOWING BEFORE YOU START${Z}"
    rule
    say ""
    say "  ${C}Nothing is erased without asking.${Z} Every destructive step stops"
    say "  and names the disk it is about to write to. Answer 'image' at the"
    say "  disk prompt to write to a file instead, and no hardware is touched."
    say ""
    say "  ${C}The root filesystem starts as RAM.${Z} Alpine boots diskless: / is"
    say "  a tmpfs that evaporates at power-off. That is normal, and it is what"
    say "  stage 3 exists to fix. Until stage 3 has run, treat anything you"
    say "  install as temporary."
    say ""
    say "  ${C}UEFI only on anything that is not a Pi.${Z} A legacy-BIOS boot"
    say "  needs Linux tools that do not exist on macOS."
    say ""
    say "  ${C}The stages are optional and re-runnable.${Z} Fifteen of them. Run"
    say "  one, run four, run all of them unattended. Nothing is a point of no"
    say "  return except stage 3, which reboots, and it tells you so."
    say ""
    say "  ${C}Copal is not a fork of Alpine.${Z} It downloads stock Alpine from"
    say "  Alpine's own mirrors and calls Alpine's own tools."
    say ""
    say "  ${D}The full account is in docs/copal-handbook.md -- 1,963 lines${Z}"
    say "  ${D}covering Alpine, the card layout, all fifteen stages and the${Z}"
    say "  ${D}desktop. README.md covers the multi-target model.${Z}"
    say ""
    rule
}

# --------------------------------------------------------------- handover ---
# A VM target is not a medium. It has no card to identify and nothing to erase,
# so the handover names an image file and copal-prep.sh never reaches its disk
# prompt at all.
#
# This is a list rather than a test on the key because getting it wrong is not
# a cosmetic fault. vmx86 was missing from it, and the effect was that someone
# who had just been shown "Equipment you need -- this Mac, and UTM. That is the
# entire list." was handed straight to "Identify the SD card", a prompt whose
# next two questions are which disk to destroy and the word ERASE. Anything
# added to the target table that is a VM belongs here on the same commit.
image_for() {
    case "$1" in
        vm)    echo "build/copal-vm.img" ;;
        vmx86) echo "build/copal-vmx86.img" ;;
        *)     echo "" ;;
    esac
}

handover() {
    k="$1"; label="$2"
    img="$(image_for "$k")"
    say ""
    say "  ${B}Ready to begin.${Z}"
    say ""
    if [ -n "$img" ]; then
        say "  This hands over to:   ${C}MODEL=${k} ./copal-prep.sh --image ${img}${Z}"
        say ""
        say "  ${D}An image file, not a disk. Nothing physical is touched, there is${Z}"
        say "  ${D}no disk to identify and no erase to confirm.${Z}"
    else
        say "  This hands over to:   ${C}MODEL=${k} ./copal-prep.sh${Z}"
        say ""
        say "  ${D}That script asks its own questions, and stops before every${Z}"
        say "  ${D}destructive step. You can still back out.${Z}"
        say ""
        say "  ${D}It asks which disk to write to. Answer ${Z}${C}image${Z}${D} there instead and it${Z}"
        say "  ${D}writes to a file, leaving every disk on this Mac alone.${Z}"
    fi
    say ""
    printf '%b' "  ${G}Begin?${Z} [y/N] "
    read -r yn </dev/tty || exit 130
    case "$yn" in
        y|Y|yes|YES)
            [ -x "$PREP" ] || { say "${R}error:${Z} $PREP is not executable"; exit 1; }
            say ""
            say "${C}==>${Z} Starting copal-prep.sh for ${B}${label}${Z}..."
            say ""
            if [ -n "$img" ]; then
                MODEL="$k" exec "$PREP" --image "$img"
            else
                MODEL="$k" exec "$PREP"
            fi
            ;;
        *)  say "  ${D}Not started. Back to the menu.${Z}" ;;
    esac
}

# ------------------------------------------------------------------ verbs ---
#
# ONE VOCABULARY. This file used to be a menu with three flags, while the same
# jobs were also spelled as make targets, as copal-prep.sh options and as
# utm-vm.sh subcommands -- four ways to say four things, and the Makefile's own
# comments spend paragraphs warning against exactly that. The verbs below are
# the answer: `copal` owns the vocabulary, and make and bin/ became aliases
# that call it rather than a second set of names to keep in step.
#
# Bare `copal` is still the menu. That has not changed and should not: the menu
# is the front door for somebody who does not yet know what they want, and the
# verbs are for somebody who does.
#
# Nothing here reimplements anything. build and cache are copal-prep.sh with
# the right MODEL, vm is utm-vm.sh, and card is copal-prep.sh with no --image
# so that its two typed ERASE confirmations happen exactly as they always did.

BUILDDIR="${BUILDDIR:-$HERE/build}"
UTMRUN="$HERE/utm/utm-vm.sh"

board_keys()  { targets | cut -d'|' -f1 | tr -d ' '; }
board_valid() { board_keys | grep -qx "$1"; }
board_list()  {
    targets | while IFS='|' read -r k l a u; do
        printf '%-6s %-30s %s\n' "$k" "$(echo "$l" | sed 's/ *$//')" "$a"
    done
}
board_or_die() {
    [ -n "${1:-}" ] || { say "${R}error:${Z} which board? One of:\n"; board_list >&2; exit 2; }
    board_valid "$1" || {
        say "${R}error:${Z} no board called '$1'. One of:\n"; board_list >&2; exit 2; }
}
img_for() { printf '%s/copal-%s.img' "$BUILDDIR" "$1"; }

# One board, unattended, the way `make auto` does it -- and now the only copy
# of that recipe, because make calls this instead of carrying its own.
#
# The transcript decides the verdict, not the exit status: the feed has to be
# unbounded or the build dies on EOF at the first step gate, and an unbounded
# feed still writing when the child exits makes script(1) report a write error
# that has nothing to do with whether the build worked.
build_unattended() {  # <board> <image path> <log>
    _b="$1"; _out="$2"; _log="$3"
    mkdir -p "$(dirname "$_log")" "$(dirname "$_out")"
    yes '' | script -q "$_log" env MODEL="$_b" "$PREP" --fresh --image "$_out" \
        >/dev/null 2>&1 || true
    grep -q 'is written and detached' "$_log" && return 0
    say "${R}error:${Z} $_b did not finish. Tail of $_log:"
    tail -20 "$_log" | tr -d '\r' | sed 's/^/    /' >&2
    return 1
}

cmd_cache() {
    case "${1:-}" in
        '') say "${R}error:${Z} which board, or 'all'? ${D}copal cache all${Z} fetches every"
            say "       architecture -- several gigabytes. Naming it is deliberate."
            exit 2 ;;
        all)
            # Every board, not the five distinct payloads -- because the cache
            # is keyed by platform and architecture, so zero2, pi4 and pi5 are
            # one download between them and the repeats cost a checksum each.
            # Deriving the set here would be a second copy of who-shares-what,
            # and this way it cannot drift.
            say "\n${C}==>${Z} Warming the cache for every board. No disk is touched.\n"
            for _b in $(board_keys); do
                say "${D}--- $_b${Z}"
                MODEL="$_b" "$PREP" --cache-only || return 1
            done
            say "\n${G}Cache warm.${Z} Every later build reads from ${CACHEDIR:-$BUILDDIR/cache}/.\n"
            ;;
        *)  board_or_die "$1"; MODEL="$1" exec "$PREP" --cache-only ;;
    esac
}

cmd_build() {
    [ "${1:-}" = all ] && { shift; cmd_build_all "$@"; return $?; }
    board_or_die "${1:-}"
    _b="$1"; shift
    _out=$(img_for "$_b"); _fresh=""; _auto=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --out) _out="${2:?--out needs a path}"; shift 2 ;;
            --out=*) _out="${1#--out=}"; shift ;;
            --fresh) _fresh="--fresh"; shift ;;
            --auto)  _auto=1; shift ;;
            *) say "${R}error:${Z} unknown option '$1' for build"; exit 2 ;;
        esac
    done
    if [ "$_auto" -eq 1 ]; then
        build_unattended "$_b" "$_out" "$BUILDDIR/copal-prep-auto-$_b.log"
        return $?
    fi
    mkdir -p "$(dirname "$_out")"
    # shellcheck disable=SC2086
    MODEL="$_b" exec "$PREP" $_fresh --image "$_out"
}

# Every board, one after another. SERIAL, and not as an oversight.
#
# Each build mounts its boot partition at /Volumes/COPALBOOT, because that is
# the label every Copal disk carries. Two at once and macOS mounts the second
# as "COPALBOOT 1" while the script writes to the first -- so copal-prep.sh now
# refuses when the mount is not its own. Running these in parallel therefore
# does not go faster; it stops. There is nothing to fix here: the label is what
# makes a card recognisable, and one build at a time is the price.
cmd_build_all() {
    say "\n${C}==>${Z} Building every board. ${Y}Serial -- one at a time, by necessity.${Z}"
    say "${D}    Boot partitions all share a label, so two builds cannot mount at once.${Z}\n"
    cmd_cache all || return 1
    _failed=''; _built=0
    for _b in $(board_keys); do
        _out=$(img_for "$_b")
        say "${C}==>${Z} ${B}$_b${Z} -> $_out"
        if build_unattended "$_b" "$_out" "$BUILDDIR/copal-prep-auto-$_b.log"; then
            _built=$((_built + 1))
            say "    ${G}ok${Z}  $(du -h "$_out" 2>/dev/null | cut -f1) on disk"
        else
            _failed="$_failed $_b"
            say "    ${R}failed${Z} -- carrying on with the rest"
        fi
    done
    say "\n${C}==>${Z} Built $_built of $(board_keys | wc -l | tr -d ' ')."
    [ -z "$_failed" ] || { say "${R}Failed:${Z}$_failed"; return 1; }
    say "${D}    Write one to a card with:  sudo dd if=$(img_for pc) of=/dev/rdiskN bs=4m${Z}\n"
}

# The VMs, both of them, from images that must already exist.
cmd_vm_all() {
    for _t in aarch64:vm x86_64:vmx86; do
        _tgt=${_t%%:*}; _mdl=${_t#*:}; _img=$(img_for "$_mdl")
        [ -f "$_img" ] || { say "${Y}skip${Z} $_tgt -- no $_img yet"; continue; }
        "$UTMRUN" status --target "$_tgt" >/dev/null 2>&1 \
            || "$UTMRUN" create --target "$_tgt" --image "$_img" || return 1
        say "${G}ok${Z}   UTM machine for $_tgt"
    done
}

cmd_all() {
    cmd_build_all || say "${Y}Some boards failed; continuing to the VMs.${Z}"
    say "\n${C}==>${Z} Registering the UTM machines\n"
    cmd_vm_all
    say "\n${G}Done.${Z} ${D}copal vm start --target aarch64${Z}\n"
}

usage() {
    say ""
    say "${B}copal${Z} ${D}-- build Copal Linux: cards, images and virtual machines${Z}"
    say ""
    say "${B}  copal${Z}                           the menu: flow chart, boards, briefings"
    say ""
    say "${B}  Building${Z}"
    say "  copal build ${C}BOARD${Z}               write ${D}build/copal-BOARD.img${Z}"
    say "  copal build ${C}BOARD${Z} --out ${C}P${Z}       write it somewhere else"
    say "  copal build ${C}BOARD${Z} --fresh       delete it first, build from nothing"
    say "  copal build ${C}BOARD${Z} --auto        unattended; answers the step gates"
    say "  copal build all                 every board, serially"
    say "  copal card ${C}BOARD${Z}                a physical card ${D}(asks twice)${Z}"
    say ""
    say "${B}  Payloads${Z}"
    say "  copal cache ${C}BOARD${Z}               download and verify, touch no disk"
    say "  copal cache all                 every architecture, once"
    say ""
    say "${B}  Virtual machines${Z}"
    say "  copal vm create --target ${C}T${Z} --image ${C}I${Z}"
    say "  copal vm ${C}start|stop|status|delete|refresh|ip${Z} --target ${C}T${Z}"
    say "  ${D}T is aarch64 or x86_64${Z}"
    say ""
    say "${B}  Everything${Z}"
    say "  copal all                       cache, build all, register both VMs"
    say ""
    say "${B}  Telling you things${Z}"
    say "  copal targets                   the board list, one per line"
    say "  copal check                     what this Mac has and lacks"
    say "  copal flow                      the flow chart alone"
    say ""
    say "  ${D}An image is a raw MBR disk:${Z}"
    say "  ${D}sudo dd if=build/copal-pc.img of=/dev/rdiskN bs=4m${Z}"
    say ""
}

# ------------------------------------------------------------------- main ---
case "${1:-}" in
    build)     shift; cmd_build "$@"; exit $? ;;
    cache)     shift; cmd_cache "$@"; exit $? ;;
    card)      shift; board_or_die "${1:-}"; MODEL="$1" exec "$PREP" ;;
    vm)        shift; exec "$UTMRUN" "$@" ;;
    all)       shift; cmd_all "$@"; exit $? ;;
    targets|boards|--targets) board_list; exit 0 ;;
    check|--check)            check_host; exit 0 ;;
    flow|--flow)              flow; exit 0 ;;
    help|-h|--help)           usage; exit 0 ;;
    '')        : ;;
    *)         say "${R}error:${Z} no verb called '$1'. Try ${B}copal help${Z}."; exit 2 ;;
esac

[ -t 0 ] || { say "${R}error:${Z} this is an interactive menu. Try --flow, --check or --targets."; exit 1; }

banner
flow
pause

while :; do
    menu
    printf '%b' "${B}Choose${Z} [1-9, f, r, w, q]: "
    read -r reply </dev/tty || exit 130
    case "$reply" in
        [1-9])
            k=$(target_key "$reply")
            l=$(target_label "$reply")
            a=$(target_arch "$reply")
            detail "$k" "$l" "$a"
            if target_ready "$k"; then
                handover "$k" "$l"
            else
                pause
            fi
            ;;
        f|F) flow; pause ;;
        r|R) check_host; pause ;;
        w|W) worth_knowing; pause ;;
        q|Q) say "\n${D}Nothing was written.${Z}\n"; exit 0 ;;
        *)   say "${Y}Not one of 1-9, f, r, w or q.${Z}" ;;
    esac
done
